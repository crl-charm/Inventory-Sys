# Copy this file to .env.local.

# Backend API (used by the /api proxy and server-side fetches).
BACKEND_URL=http://localhost:4000

# Optional: overrides the store name shown in the app (default "R Garage").
# NEXT_PUBLIC_STORE_NAME=R Garage

# Business timezone for "today" on sales/dashboard pages.
APP_TIME_ZONE=Asia/Manila
