# Copy this file to .env.local.

# Backend API (used by the /api proxy and server-side fetches).
BACKEND_URL=http://localhost:4000

# Optional: how long the /api proxy waits for a sleeping/restarting API.
# Defaults are tuned for Render's free plan (cold start ~30-60 s).
# UPSTREAM_TIMEOUT_MS=45000        per attempt
# UPSTREAM_TOTAL_BUDGET_MS=90000   whole call, including waits
# UPSTREAM_MAX_ATTEMPTS=4          tries for reads / replay-safe requests
# LOG_LEVEL=info                   debug | info | warn | error

# Optional: overrides the store name shown in the app (default "R Garage").
# NEXT_PUBLIC_STORE_NAME=R Garage

# Business timezone for "today" on sales/dashboard pages.
APP_TIME_ZONE=Asia/Manila
