# Copy this file to .env.local and set real values.
# Never commit .env.local.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hardware_inventory
DB_USER=root
DB_PASSWORD=

# Managed MySQL providers (Aiven, DigitalOcean, TiDB…) require TLS.
# DB_SSL=true encrypts the connection; DB_SSL_CA (the provider's ca.pem
# contents — real newlines or \n escapes) additionally verifies the server
# certificate. Leave both unset for local XAMPP MySQL.
# DB_SSL=false
# DB_SSL_CA=

# Optional database tuning (defaults shown):
# DB_CONNECT_TIMEOUT_MS=10000   fail fast when the DB host is unreachable
# DB_QUERY_TIMEOUT_MS=20000     server-side cap for SELECT statements
# LOG_LEVEL=info                debug | info | warn | error
# MYSQL_DUMP_PATH=C:\xampp1\mysql\bin\mysqldump.exe  native client for db:backup

# --- App ---
APP_TIME_ZONE=Asia/Manila
# Optional: overrides the store name shown in the app (default "R Garage").
# NEXT_PUBLIC_STORE_NAME=R Garage

# Long random secret, at least 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_bytes

# Optional additional allowed browser origins for mutating APIs (same-origin
# requests are always allowed automatically).
# FRONTEND_ORIGIN=http://localhost:3000

# --- Owner seed (used by `npm run db:seed-owner` only) ---
# SEED_OWNER_USERNAME=owner
# SEED_OWNER_PASSWORD=
# SEED_OWNER_NAME=Owner
