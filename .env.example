# Copy this file to .env.local and set real local values.
# Never commit .env.local. Never prefix any of these with NEXT_PUBLIC_.

# --- Database (XAMPP / MariaDB defaults: host 127.0.0.1, port 3306, user root, empty password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hardware_inventory
DB_USER=root
DB_PASSWORD=

# --- App ---
# Business timezone for "today" and sale dates.
APP_TIME_ZONE=Asia/Manila
# Optional: shown as the store name in the sidebar (defaults to "Hardware Store").
# NEXT_PUBLIC_STORE_NAME=My Hardware Store
# Long random secret, at least 32 bytes. Example generator:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_bytes

# --- Owner seed (used by `npm run db:seed-owner`; never used by the running app) ---
# SEED_OWNER_USERNAME=owner
# SEED_OWNER_PASSWORD=
# SEED_OWNER_NAME=Owner
