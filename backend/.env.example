# Copy this file to .env.local and set real values.
# Never commit .env.local.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hardware_inventory
DB_USER=root
DB_PASSWORD=

# Managed MySQL providers (Aiven, DigitalOcean, TiDB…) require TLS.
# DB_SSL=true encrypts the connection; DB_SSL_CA (the provider's ca.pem
# contents — real newlines or \n escapes) additionally verifies the server
# certificate. Leave both unset for local XAMPP MySQL.
# DB_SSL=false
# DB_SSL_CA=

# --- App ---
APP_TIME_ZONE=Asia/Manila
# Long random secret, at least 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_bytes

# Browser origins allowed to call mutating APIs (the frontend service).
# Accepts a comma/space-separated list — add the LAN origin to sign in from a
# phone, e.g.
#   FRONTEND_ORIGIN=http://localhost:3000,http://192.168.1.50:3000
FRONTEND_ORIGIN=http://localhost:3000

# Render sets PORT. Local default is 4000.
# PORT=4000
# Public hosts (Render) need HOST=0.0.0.0; local default is 127.0.0.1.
# HOST=0.0.0.0

# --- Owner seed (used by `npm run db:seed-owner` only) ---
# SEED_OWNER_USERNAME=owner
# SEED_OWNER_PASSWORD=
# SEED_OWNER_NAME=Owner
