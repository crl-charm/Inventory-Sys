{
  "name": "hardware-inventory-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/db-init.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:import": "tsx scripts/db-import.ts",
    "db:ping": "tsx scripts/db-ping.ts",
    "db:seed-owner": "tsx scripts/seed-owner.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "mysql2": "^3.24.6",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.8.0"
  }
}
